        {
          "name": "1.1 List all ML models",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ml/models",
              "host": ["{{base_url}}"],
              "path": ["ml", "models"]
            },
            "description": "GET /api/v1/ml/models\nReturns list of all ML models with version info"
          },
          "response": []
        },
