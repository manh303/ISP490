MAILJET_API_KEY=0577893665068e154a703ae532f617ed
MAILJET_API_SECRET=a518e0492ff0ba92d1d304570cb97840
EMAIL_FROM=mtminh1606@gmail.com
EMAIL_FROM_NAME=DSS E-commerce

# Alternative: You can use other email services
# For other providers, adjust the SMTP settings in email_service.py

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=E-commerce DSS API
VERSION=2.0.0

# Development/Production Mode
ENVIRONMENT=development
DEBUG=false

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Features
ENABLE_CORS=true
ENABLE_GZIP=true
ENABLE_SECURITY_HEADERS=true

# Database Pool Settings
MAX_CONNECTIONS_COUNT=10
MIN_CONNECTIONS_COUNT=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Session Management
SESSION_TIMEOUT=3600
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=csv,json,xlsx

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30